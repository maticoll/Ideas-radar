# ----- Database (PostgreSQL / Neon) -----
# Vercel + Neon: paste your Neon connection string here. Use the POOLED string
# (host contains "-pooler") for serverless, and add ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ----- Cron / seed protection -----
# Required in production. Vercel Cron sends "Authorization: Bearer <CRON_SECRET>".
# Also protects POST /api/seed.
CRON_SECRET="change-me-to-a-long-random-string"

# ----- Optional AI layer (Claude) -----
# If unset, the engine uses deterministic heuristics (works fully offline).
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-4-6"
AI_ENABLED="false"

# ----- Real source integrations (empty => mock layer is used) -----
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="idea-radar/1.0"
TWITTER_BEARER_TOKEN=""
PRODUCTHUNT_TOKEN=""
TRENDS_PROVIDER_KEY=""
