# ----- Database -----
# Default: local SQLite (zero setup). To switch to PostgreSQL, change the
# provider in prisma/schema.prisma to "postgresql" and set DATABASE_URL below.
DATABASE_URL="file:./dev.db"
# PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/idearadar?schema=public"

# ----- Cron protection -----
# Optional bearer token to protect /api/cron/* endpoints.
CRON_SECRET="dev-secret-change-me"

# ----- Optional AI layer (Claude) -----
# If unset, the engine uses deterministic heuristics (works fully offline).
# If set, the analysis layer can call Claude to enrich idea summaries/MVPs.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-4-6"
AI_ENABLED="false"

# ----- Real source integrations (left empty => mock layer is used) -----
# Reddit API (https://www.reddit.com/prefs/apps) — respect Reddit API terms.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="idea-radar/1.0"
# X / Twitter — use official API or an authorized provider only.
TWITTER_BEARER_TOKEN=""
# Product Hunt API (https://api.producthunt.com).
PRODUCTHUNT_TOKEN=""
# Google Trends has no official API; plug an authorized provider here.
TRENDS_PROVIDER_KEY=""
