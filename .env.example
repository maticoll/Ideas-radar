# ----- Database (PostgreSQL / Neon) -----
# Vercel + Neon: paste your Neon connection string here. Use the POOLED string
# (host contains "-pooler") for serverless, and add ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ----- App access gate (single user) -----
# Personal lock for the whole app. Set this and the site asks for the password
# on /unlock before letting anyone in. If left EMPTY the gate is DISABLED and the
# app is open (handy for local dev). Set it in production to protect your demo.
APP_PASSWORD=""
# Optional: dedicated secret used to sign the session cookie. Defaults to
# APP_PASSWORD if unset. Changing it invalidates existing sessions.
APP_SESSION_SECRET=""

# ----- Cron / seed protection -----
# Required in production. Vercel Cron / GitHub Actions send
# "Authorization: Bearer <CRON_SECRET>". Also protects POST /api/seed and
# /api/admin/refresh, and lets those server-to-server calls bypass the app gate.
CRON_SECRET="change-me-to-a-long-random-string"

# ----- Ranking window -----
# runRanking() only clusters signals collected within the last N days (uses the
# raw_signals.collected_at index) so re-rankings don't re-scan the whole history.
# Default 90. Set to 0 to disable the window and consider every stored signal.
RANKING_WINDOW_DAYS="90"

# ----- Optional AI layer (Claude) -----
# If ANTHROPIC_API_KEY is unset, the engine uses deterministic heuristics
# (works fully offline). With a key, AI is ON by default: it rewrites the
# qualitative fields of every opportunity from its real evidence and names the
# semantic clusters discovered by the ranking. Set AI_ENABLED="false" to opt
# out while keeping the key configured. Scoring is never AI-driven.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-4-6"
AI_ENABLED=""

# ----- Clustering engine (T6) -----
# "semantic" (default): blueprint seeds first, then TF-IDF/cosine clustering of
# the leftover signals so opportunities emerge from the data. "keyword":
# blueprint-only (the previous behaviour).
CLUSTER_ENGINE="semantic"
# Tuning: min cosine similarity to join a cluster, and min signals per cluster.
SEMANTIC_SIM_THRESHOLD="0.10"
SEMANTIC_MIN_CLUSTER="2"

# ----- Real source integrations (empty => mock layer is used) -----
# Hacker News (Algolia) and Stack Exchange need NO credentials — they always
# fetch real data and only fall back to demo if the network call fails.
# Reddit: create a free "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="idea-radar/1.0"
# X/Twitter: /2/tweets/search/recent requires a PAID tier (Basic+). Free-tier
# tokens get HTTP 402 and the collector falls back to demo.
TWITTER_BEARER_TOKEN=""
PRODUCTHUNT_TOKEN=""
# Google Trends via SerpApi (https://serpapi.com, engine=google_trends).
TRENDS_PROVIDER_KEY=""
# Real mode refreshes each trend keyword at most once per N days to respect the
# SerpApi quota (2 calls per keyword per refresh). Default 7.
TRENDS_REFRESH_DAYS="7"
