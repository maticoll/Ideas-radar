// Idea Radar — data model
// Provider is PostgreSQL (Neon) for Vercel deploys.
// DATABASE_URL must point to your Postgres instance.
// For local dev you can point DATABASE_URL to the same Neon DB (or any Postgres).
// Array/object fields use native JSONB (Postgres) so they can be queried and
// indexed; Prisma serializes/parses them automatically (no manual encode/decode).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(cuid())
  name      String
  email     String      @unique
  createdAt DateTime    @default(now()) @map("created_at")
  saved     SavedIdea[]

  @@map("users")
}

model RawSignal {
  id                 String              @id @default(cuid())
  source             String // reddit | twitter | producthunt
  sourceUrl          String              @map("source_url")
  sourceAuthor       String?             @map("source_author")
  text               String
  engagementScore    Int                 @default(0) @map("engagement_score")
  createdAtSource    DateTime            @map("created_at_source")
  collectedAt        DateTime            @default(now()) @map("collected_at")
  language           String              @default("en")
  category           String
  keywords           Json                @default("[]") // string[] (JSONB)
  painScore          Int                 @default(0) @map("pain_score")
  paymentIntentScore Int                 @default(0) @map("payment_intent_score")
  matchedPattern     String?             @map("matched_pattern")
  opportunities      OpportunitySignal[]

  @@index([source])
  @@index([category])
  @@index([collectedAt])
  @@index([sourceUrl])
  @@map("raw_signals")
}

model ProductHuntProduct {
  id               String   @id @default(cuid())
  name             String
  description      String
  url              String
  launchDate       DateTime @map("launch_date")
  upvotes          Int      @default(0)
  commentsCount    Int      @default(0) @map("comments_count")
  lastActivityDate DateTime @map("last_activity_date")
  abandonedScore   Int      @default(0) @map("abandoned_score")
  activeReviewScore Int     @default(0) @map("active_review_score")
  siteStatus       String   @default("unknown") @map("site_status")
  category         String

  @@map("product_hunt_products")
}

model Trend {
  id             String   @id @default(cuid())
  keyword        String
  region         String   @default("Worldwide")
  trendScore     Int      @default(0) @map("trend_score")
  growth12m      Int      @default(0) @map("growth_12m") // percent
  relatedQueries Json     @default("[]") @map("related_queries") // string[] (JSONB)
  series         Json     @default("[]") // {month, value}[] (JSONB)
  collectedAt    DateTime @default(now()) @map("collected_at")

  @@map("trends")
}

model Opportunity {
  id                 String              @id @default(cuid())
  title              String
  problem            String
  audience           String
  whyNow             String              @default("") @map("why_now")
  evidence           String              @default("") // narrative summary
  gap                String
  mvp                String
  businessModel      String              @map("business_model")
  competitors        Json                @default("[]") // string[] (JSONB)
  category           String
  region             String              @default("Worldwide")
  segment            String              @default("B2C") // B2B | B2C | B2B2C
  demandScore        Int                 @default(0) @map("demand_score")
  painScore          Int                 @default(0) @map("pain_score")
  paymentIntentScore Int                 @default(0) @map("payment_intent_score")
  trendScore         Int                 @default(0) @map("trend_score")
  competitionScore   Int                 @default(0) @map("competition_score")
  executionScore     Int                 @default(0) @map("execution_score")
  finalScore         Int                 @default(0) @map("final_score")
  scoreBreakdown     Json                @default("{}") @map("score_breakdown") // ScoreBreakdown (JSONB)
  trendKeyword       String?             @map("trend_keyword")
  rankDate           DateTime            @default(now()) @map("rank_date")
  previousRank       Int?                @map("previous_rank")
  rank               Int?
  createdAt          DateTime            @default(now()) @map("created_at")
  signals            OpportunitySignal[]
  saved              SavedIdea[]
  snapshots          RankingSnapshot[]

  @@index([category])
  @@index([finalScore])
  @@map("opportunities")
}

// One row per opportunity per ranking run — lets us chart how an idea's
// score/rank moved over time (Opportunity.rank/previousRank only keep the last
// run). Written in bulk at the end of runRanking().
model RankingSnapshot {
  id            String      @id @default(cuid())
  opportunityId String      @map("opportunity_id")
  rank          Int
  finalScore    Int         @map("final_score")
  date          DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, date])
  @@map("ranking_snapshots")
}

model OpportunitySignal {
  id            String      @id @default(cuid())
  opportunityId String      @map("opportunity_id")
  rawSignalId   String      @map("raw_signal_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  rawSignal     RawSignal   @relation(fields: [rawSignalId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, rawSignalId])
  @@map("opportunity_signals")
}

model SavedIdea {
  id            String      @id @default(cuid())
  userId        String      @map("user_id")
  opportunityId String      @map("opportunity_id")
  status        String      @default("research") // research | validate | discard | build
  notes         String      @default("")
  createdAt     DateTime    @default(now()) @map("created_at")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@map("saved_ideas")
}
